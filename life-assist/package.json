    "@react-three/postprocessing": "^2.19.1",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@types/three": "^0.185.1",
    "dexie": "^4.0.8",
    "firebase": "^10.12.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.395.0",
    "postprocessing": "^6.39.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
