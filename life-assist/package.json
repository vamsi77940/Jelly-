{
  "name": "life-assist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LifeAssist — a Jarvis-style personal operating system. Phase 0: modular React/TS scaffold.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
